# ---------- Node / frontend (yarn only) ----------
node_modules/

# yarn.lock and .yarnrc.yml are COMMITTED. If you move to Yarn Berry, the
# cache is ignored below but releases/patches/plugins stay in the repo.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

yarn-debug.log*
yarn-error.log*

# Not our package manager — if these appear, something ran the wrong CLI.
package-lock.json
pnpm-lock.yaml
npm-debug.log*

# Vite / build output
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# Frontend env (Vite exposes anything VITE_* to the browser — keep keys out)
