+## compute_payout
+description: Compute the payable amount once coverage is decided: subtracts the excess from the covered amount, then caps the result at a special limit if one is given. Returns 0 for denied or undetermined. Arithmetic only; it does not look anything up and does not decide coverage.
+{
+  "type": "object",
+  "properties": {
+    "claim_status": {
+      "type": "string",
+      "enum": [
+        "covered",
+        "partial",
+        "denied",
+        "undetermined"
+      ],
+      "description": "The coverage decision already reached."
+    },
+    "covered_amount": {
+      "type": "number",
+      "minimum": 0,
+      "description": "The part of the claimed amount the policy covers, before the excess."
+    },
+    "excess": {
+      "type": "number",
+      "minimum": 0,
+      "description": "The deductible that the governing wording applies to this loss."
+    },
+    "special_limit": {
+      "type": [
+        "number",
+        "null"
+      ],
+      "minimum": 0,
+      "description": "A special limit of liability that caps this loss, applied AFTER the excess; null when none applies."
+    }
+  },
+  "required": [
+    "claim_status",
+    "covered_amount",
+    "excess",
+    "special_limit"
+  ],
+  "additionalProperties": false
+}
+
