{
  "mcpServers": {
    "policy-docs": {
      "command": "${PYTHON}",
      "args": [
        "-m",
        "app.mcp_servers.policy_server"
      ],
      "cwd": "backend",
      "env": {
        "ANONYMIZED_TELEMETRY": "False",
        "TOKENIZERS_PARALLELISM": "false",
        "FASTMCP_LOG_LEVEL": "WARNING",
        "TRIAGE_VERSION": "${TRIAGE_VERSION:-triage-v2}",
        "W12_MCP_SPAN_FILE": "${W12_MCP_SPAN_FILE}"
      },
      "expose_tools": [
        "search_policy"
      ]
    },
    "claims-system": {
      "command": "${PYTHON}",
      "args": [
        "server.py"
      ],
      "cwd": "vendor/claims_system_mcp",
      "env": {
        "CLAIMS_API_TOKEN": "${CLAIMS_API_TOKEN:-demo-readonly-token}",
        "CLAIMS_DATA": "../../data/policies/claims_store.json",
        "CLAIMS_SYSTEM_LOG": "../../week12/obs/claims_system_access.log",
        "FASTMCP_LOG_LEVEL": "WARNING"
      },
      "expose_tools": []
    }
  }
}