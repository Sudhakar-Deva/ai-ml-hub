# Copy to .env at the repo root and fill in. .env is gitignored.
# Every value below has a working default in backend/app/config.py — you only
# need to set LLM_API_KEY to get running.

# --- LLM (cited answers + forced refusals, summaries, judge, agent) ---
# Provider: groq (default) or anthropic. Every model call goes through
# backend/app/llm.py, so this one value switches all of them.
LLM_PROVIDER=groq
LLM_API_KEY=your_api_key_here
# Default for groq: openai/gpt-oss-120b   (anthropic: claude-sonnet-5)
# LLM_MODEL=
# gpt-oss reasoning effort, pinned so every call and trace uses the same one.
# LLM_REASONING_EFFORT=low
# USD per 1M tokens for the Week 7 cost column — check https://groq.com/pricing
# GROQ_PRICE_IN=0.15
# GROQ_PRICE_OUT=0.60

# --- Embeddings ---
# Runs locally, no API key needed.
# Default: sentence-transformers/all-MiniLM-L6-v2  (384-dim, fast)
# Bigger option: sentence-transformers/all-mpnet-base-v2  (768-dim, slower)
# Swap this ONE value to change embedding strategy — never in the same run as a
# chunker change, or the number tells you nothing about which one moved it.
# EMBEDDING_MODEL=

# --- Vector store (gitignored) ---
# Default: backend/.chroma
# VECTOR_DB_PATH=

# --- API ---
# Defaults: 127.0.0.1 : 8000
# API_HOST=
# API_PORT=
